generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum SubmissionStatus {
  DRAFT
  UPLOADING
  UPLOADED
  QUEUED
  PROCESSING
  EVALUATING
  COMPLETED
  FAILED
}

enum ArtifactType {
  GITHUB
  ZIP
  PDF
  GOOGLE_DRIVE
  VIDEO
  DOCUMENT
  LIVE_URL
}

enum ArtifactStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  REJECTED
}

enum EvaluationStatus {
  PENDING
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  HUMAN_REVIEW
  CANCELLED
}

enum AttemptStatus {
  RUNNING
  SUCCEEDED
  FAILED
  TIMED_OUT
}

enum HumanReviewStatus {
  REQUESTED
  IN_PROGRESS
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      UserRole @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courseMemberships CourseMember[]
  submissions       Submission[]
  humanReviews      HumanReview[]
  auditLogs         AuditLog[]

  @@index([role])
}

model Course {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     CourseMember[]
  assignments Assignment[]
}

model CourseMember {
  id        String   @id @default(uuid())
  courseId  String
  userId    String
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([userId])
}

model Assignment {
  id          String   @id @default(uuid())
  courseId    String
  title       String
  description String?
  deadline    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  rubrics      Rubric[]
  submissions  Submission[]

  @@index([courseId])
  @@index([deadline])
}

model Rubric {
  id           String   @id @default(uuid())
  assignmentId String
  name         String
  version      Int
  createdAt    DateTime @default(now())

  assignment Assignment      @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  criteria   RubricCriterion[]
  evaluations EvaluationJob[]

  @@unique([assignmentId, version])
  @@index([assignmentId])
}

model RubricCriterion {
  id                   String   @id @default(uuid())
  rubricId             String
  name                 String
  description          String?
  weight               Decimal  @db.Decimal(5, 2)
  maxScore             Decimal  @db.Decimal(5, 2)
  evaluationGuidelines String?
  createdAt            DateTime @default(now())

  rubric            Rubric                       @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  criterionResults  EvaluationCriterionResult[]

  @@index([rubricId])
}

model Submission {
  id           String           @id @default(uuid())
  assignmentId String
  studentId    String
  status       SubmissionStatus @default(DRAFT)
  projectManifest Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  artifacts  SubmissionArtifact[]
  evaluations EvaluationJob[]
  evaluationChunks EvaluationChunk[]

  @@index([assignmentId])
  @@index([studentId])
  @@index([status])
}

model SubmissionArtifact {
  id           String         @id @default(uuid())
  submissionId String
  type         ArtifactType
  status       ArtifactStatus @default(PENDING)
  storageKey   String?
  sourceUrl    String?
  fileName     String?
  fileSize     BigInt?
  checksum     String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([checksum])
}

model EvaluationJob {
  id             String           @id @default(uuid())
  submissionId   String
  rubricId       String
  evaluationKey  String
  status         EvaluationStatus @default(PENDING)
  priority       Int              @default(0)
  idempotencyKey String?
  createdAt      DateTime         @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  updatedAt      DateTime         @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  rubric     Rubric     @relation(fields: [rubricId], references: [id], onDelete: Restrict)
  attempts   EvaluationAttempt[]
  result     EvaluationResult?
  humanReview HumanReview?

  @@unique([submissionId, evaluationKey])
  @@unique([submissionId, idempotencyKey])
  @@index([status])
  @@index([submissionId])
  @@index([rubricId])
}

model EvaluationChunk {
  id             String   @id @default(uuid())
  submissionId   String
  filePath       String
  chunkIndex     Int
  content        String
  tokenEstimate  Int
  embedding      Unsupported("vector(1536)")?
  createdAt      DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, filePath, chunkIndex])
  @@index([submissionId])
}

model EvaluationAttempt {
  id             String        @id @default(uuid())
  evaluationJobId String
  attemptNumber  Int
  status         AttemptStatus @default(RUNNING)
  workerId       String?
  errorCode      String?
  errorMessage   String?
  startedAt      DateTime      @default(now())
  completedAt    DateTime?

  evaluationJob EvaluationJob @relation(fields: [evaluationJobId], references: [id], onDelete: Cascade)

  @@unique([evaluationJobId, attemptNumber])
  @@index([evaluationJobId])
}

model EvaluationResult {
  id             String   @id @default(uuid())
  evaluationJobId String   @unique
  totalScore     Decimal  @db.Decimal(7, 2)
  maxScore       Decimal  @db.Decimal(7, 2)
  summary        String?
  createdAt      DateTime @default(now())

  evaluationJob EvaluationJob             @relation(fields: [evaluationJobId], references: [id], onDelete: Cascade)
  criteria      EvaluationCriterionResult[]
}

model EvaluationCriterionResult {
  id                 String  @id @default(uuid())
  evaluationResultId  String
  rubricCriterionId   String
  score              Decimal @db.Decimal(7, 2)
  maxScore            Decimal @db.Decimal(7, 2)
  confidence         Decimal? @db.Decimal(4, 3)
  reasoning          String?
  evidence            Json?
  createdAt           DateTime @default(now())

  evaluationResult EvaluationResult @relation(fields: [evaluationResultId], references: [id], onDelete: Cascade)
  rubricCriterion  RubricCriterion  @relation(fields: [rubricCriterionId], references: [id], onDelete: Restrict)

  @@unique([evaluationResultId, rubricCriterionId])
  @@index([rubricCriterionId])
}

model HumanReview {
  id             String             @id @default(uuid())
  evaluationJobId String             @unique
  reviewerId     String
  status         HumanReviewStatus  @default(REQUESTED)
  comments       String?
  finalScore     Decimal?           @db.Decimal(7, 2)
  createdAt      DateTime           @default(now())
  completedAt    DateTime?

  evaluationJob EvaluationJob @relation(fields: [evaluationJobId], references: [id], onDelete: Cascade)
  reviewer      User          @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([reviewerId])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}